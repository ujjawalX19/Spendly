+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { projectMonthly, riskScore, buildContext } = require('../lib/financialContext');
+
+const NOW = new Date('2026-04-15T06:00:00Z');
+const rows = (n, amount, category, day = 5) =>
+    Array.from({ length: n }, (_, i) => ({ amount, category, occurred_at: `2026-04-${String((i % 14) + 1).padStart(2, '0')}T06:00:00Z` }));
+
+// ── Compounding ─────────────────────────────────────────────────────────────
+
+test('a SIP grows to the textbook future value', () => {
+    // ₹5,000/month for 10 years at 12% is ~₹11.6 lakh by the standard
+    // annuity-due formula. Checked against the closed form, not vibes.
+    const p = projectMonthly(5000);
+    const tenYear = p.horizons.find((h) => h.years === 10);
+    assert.ok(Math.abs(tenYear.value - 1161695) < 5000, `got ${tenYear.value}`);
+    assert.equal(tenYear.invested, 600000);
+    assert.equal(tenYear.gain, tenYear.value - tenYear.invested);
+});
+
+test('every horizon gains more than it invests, and grows with time', () => {
+    const p = projectMonthly(2000);
+    const values = p.horizons.map((h) => h.value);
+    assert.deepEqual(values, [...values].sort((a, b) => a - b), 'must increase with horizon');
+    for (const h of p.horizons) {
+        assert.ok(h.value > h.invested, `${h.years}y should beat contributions`);
+    }
+});
+
+test('the cost of waiting a year is the year of compounding lost at the end', () => {
+    const p = projectMonthly(5000);
+    // Delaying shifts the whole schedule: you end with 9 years of growth, not 10.
+    assert.ok(p.costOfWaitingOneYear > 0);
+    // For ₹5,000 at 12% this is well over a lakh — the number that makes the
+    // point land.
+    assert.ok(p.costOfWaitingOneYear > 100000, `got ${p.costOfWaitingOneYear}`);
+});
+
+test('nothing to invest returns null rather than a fictional projection', () => {
+    assert.equal(projectMonthly(0), null);
+    assert.equal(projectMonthly(-500), null);
+    assert.equal(projectMonthly(null), null);
+    assert.equal(projectMonthly('abc'), null);
+});
+
+test('the assumed rate is disclosed, not hidden', () => {
+    assert.equal(projectMonthly(1000).assumedAnnualReturn, 0.12);
+    assert.equal(projectMonthly(1000, { annualRate: 0.08 }).assumedAnnualReturn, 0.08);
+    assert.ok(projectMonthly(1000, { annualRate: 0.08 }).horizons[3].value
+        < projectMonthly(1000, { annualRate: 0.12 }).horizons[3].value);
+});
+
+// ── Risk score ──────────────────────────────────────────────────────────────
+
+const ctxFrom = (over) => buildContext({ ...over, now: NOW });
+
+test('a healthy month scores low', () => {
+    const r = riskScore(ctxFrom({
+        thisMonth: rows(12, 200, 'Food'),          // 2,400 of 20,000 by day 15
+        lastMonth: rows(12, 200, 'Food'),
+        profile: { monthly_budget: 20000 },
+    }));
+    assert.equal(r.band, 'low');
+    assert.ok(r.score < 30, `got ${r.score}`);
+});
+
+test('being over budget scores high and says why', () => {
+    const r = riskScore(ctxFrom({
+        thisMonth: rows(15, 1000, 'Food'),         // 15,000 of 10,000
+        lastMonth: rows(12, 100, 'Food'),
+        profile: { monthly_budget: 10000 },
+    }));
+    assert.equal(r.band, 'high');
+    assert.match(r.factors.join(' '), /over budget/i);
+});
+
+test('every point of the score is attributed to a named factor', () => {
+    const r = riskScore(ctxFrom({
+        thisMonth: rows(20, 900, 'Food'),
+        lastMonth: rows(12, 100, 'Food'),
+        profile: { monthly_budget: 10000 },
+        bills: [{ amount: 5000, due_day: 25, is_active: true }],
+    }));
+    assert.ok(r.score > 0);
+    assert.ok(r.factors.length > 0, 'a score with no explanation is unusable');
+    for (const f of r.factors) assert.ok(f.length > 5);
+});
+
+test('score is clamped to 0-100', () => {
+    const r = riskScore(ctxFrom({
+        thisMonth: rows(30, 5000, 'Food'),
+        lastMonth: rows(12, 10, 'Food'),
+        profile: { monthly_budget: 1000 },
+        bills: [{ amount: 50000, due_day: 30, is_active: true }],
+    }));
+    assert.ok(r.score >= 0 && r.score <= 100, `got ${r.score}`);
+});
+
+test('thin history marks the score unreliable', () => {
+    const thin = riskScore(ctxFrom({
+        thisMonth: rows(2, 100, 'Food'), lastMonth: [], profile: { monthly_budget: 10000 },
+    }));
+    assert.equal(thin.reliable, false);
+
+    const solid = riskScore(ctxFrom({
+        thisMonth: rows(12, 100, 'Food'), lastMonth: rows(12, 100, 'Food'), profile: { monthly_budget: 10000 },
+    }));
+    assert.equal(solid.reliable, true);
+});
+
+test('no budget set is itself flagged', () => {
