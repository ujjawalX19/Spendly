+
+/**
+ * What a monthly amount becomes if invested, and what it costs to delay.
+ *
+ * Compounding is the one piece of maths that changes behaviour once someone
+ * actually sees it, and the "cost of waiting a year" line is what makes it
+ * land — it turns an abstract curve into a number you lost.
+ *
+ * Rates are historical long-run averages for Indian equity index funds. They
+ * are assumptions, not predictions, and every caller must present them that way.
+ */
+function projectMonthly(monthly, { annualRate = 0.12 } = {}) {
+    const amount = Number(monthly) || 0;
+    if (amount <= 0) return null;
+
+    const r = annualRate / 12;
+    const fv = (months) => amount * (((1 + r) ** months - 1) / r) * (1 + r);
+
+    const horizons = [1, 3, 5, 10].map((years) => {
+        const value = Math.round(fv(years * 12));
+        const invested = amount * years * 12;
+        return { years, value, invested: Math.round(invested), gain: Math.round(value - invested) };
+    });
+
+    // Starting a year later means one fewer year of compounding at the end.
+    const tenYear = fv(120);
+    const nineYear = fv(108);
+
+    return {
+        monthly: Math.round(amount),
+        assumedAnnualReturn: annualRate,
+        horizons,
+        costOfWaitingOneYear: Math.round(tenYear - nineYear),
+    };
+}
+
+/**
+ * A plain-language risk score, 0-100, where higher means more financially
+ * fragile this month. Deliberately simple and explainable: a score a user
+ * cannot understand is a score they cannot act on, so every point is
+ * attributed to a named factor.
+ */
+function riskScore(ctx) {
+    const factors = [];
+    let score = 0;
+
+    if (ctx.budget > 0) {
+        const used = ctx.spentThisMonth / ctx.budget;
+        if (used > 1) {
+            score += 35;
+            factors.push('Already over budget this month');
+        } else if (ctx.onPaceToOverspend) {
+            score += 25;
+            factors.push('On pace to finish the month over budget');
+        } else if (used > 0.8 && ctx.daysLeft > 7) {
+            score += 15;
+            factors.push('Most of the budget is spent with a week or more to go');
+        }
+    } else {
+        score += 10;
+        factors.push('No monthly budget set');
+    }
+
+    if (ctx.safeToSpendRemaining === 0 && ctx.budget > 0) {
+        score += 20;
+        factors.push('Nothing left after bills and savings target');
+    }
+
+    if (ctx.upcomingBills > 0 && ctx.upcomingBills > ctx.safeToSpendRemaining) {
+        score += 20;
+        factors.push('Upcoming bills exceed what is left');
+    }
+
+    // Concentration: one category dominating is fragile, because one habit
+    // change is the only lever available.
+    const top = ctx.topCategories[0];
+    if (top && ctx.spentThisMonth > 0 && top.amount / ctx.spentThisMonth > 0.5) {
+        score += 10;
+        factors.push(`${top.category} is over half of all spending`);
+    }
+
+    const spike = ctx.biggestMovers[0];
+    if (spike && spike.change > 0 && ctx.spentLastMonth > 0 && spike.change > ctx.spentLastMonth * 0.2) {
+        score += 10;
+        factors.push(`${spike.category} jumped sharply versus last month`);
+    }
+
+    score = Math.max(0, Math.min(100, score));
+    const band = score >= 60 ? 'high' : score >= 30 ? 'moderate' : 'low';
+
+    return {
+        score,
+        band,
+        factors,
+        // Without enough history this is a guess, and must be presented as one.
+        reliable: ctx.confidence === 'good',
+    };
+}
+
+module.exports = { buildContext, describeContext, byCategory, projectMonthly, riskScore };
