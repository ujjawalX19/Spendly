+/**
+ * pricing — one definition of what Spendly Pro costs and what it includes.
+ *
+ * Shared by the backend and mirrored in the client so the paywall, the Pro
+ * screen and the Play Console product can never drift apart. A user seeing a
+ * different price on the upgrade screen than at checkout is the fastest way to
+ * lose the sale and the trust.
+ *
+ * WHY A ONE-TIME UNLOCK RATHER THAN A SUBSCRIPTION
+ * Indian users convert markedly better on one-time purchases for utility apps
+ * than on recurring ones, and a solo developer avoids churn, dunning, refunds
+ * and renewal support entirely. Recurring revenue that is never collected is
+ * worth less than a one-time payment that is.
+ */
+
+const PRO = {
+    // Google Play product id — must match the SKU created in Play Console.
+    productId: 'spendly_pro_lifetime',
+    type: 'one_time',
+
+    priceInr: 299,
+    displayPrice: '₹299',
+    displayTagline: 'one-time · yours forever',
+
+    /**
+     * What Pro unlocks. Deliberately does NOT include basic expense tracking:
+     * charging for the core loop would kill the habit the whole product
+     * depends on, and a free tier that does not work is not a free tier.
+     */
+    includes: [
+        'Unlimited AI coaching (free: 10 messages a day)',
+        'Unlimited receipt scans (free: 3 a month)',
+        'Subscription cancellation guides and savings tracking',
+        'Bank statement import',
+        'Advanced insights and spending anomalies',
+        'Data export',
+    ],
+
+    /** Stays free, forever. */
+    alwaysFree: [
+        'Automatic UPI expense tracking',
+        'Dashboard and Safe-to-Spend',
+        'Transaction search and history',
+        'Manual expenses and categories',
+    ],
+};
+
+module.exports = { PRO };
