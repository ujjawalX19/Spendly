# Copy to android/keystore.properties and fill in real values.
# NEVER commit the real file or the .jks/.keystore itself — both are git-ignored.
#
# Create an upload key once:
#   keytool -genkeypair -v -keystore vittova-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias vittova-upload
#
# Back up the keystore and its passwords somewhere safe. If you lose the upload
# key you must ask Google to reset it, and without Play App Signing enrolment
# you would be unable to update the app at all.

storeFile=vittova-upload.jks
storePassword=CHANGE_ME
keyAlias=vittova-upload
keyPassword=CHANGE_ME
