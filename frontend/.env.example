# Supabase credentials – get from supabase.com → Project Settings → API
# The ANON key only. The service-role key must never be in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Vittova API (the backend). Unset builds use the production API (lib/apiConfig.js).
VITE_API_URL=http://localhost:5000/api

# Optional: the support address shown in the app (defaults in lib/legal.js).
# VITE_SUPPORT_EMAIL=
