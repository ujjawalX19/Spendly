# Application Port
PORT=5000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the SERVICE ROLE key (not the anon/public key).
# This allows the server to verify JWTs and perform privileged operations.
# NEVER expose this key on the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Gemini API Key for Chatbot & Receipt OCR
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────
# Production frontend URL for strict CORS (e.g. https://spendly.vercel.app)
FRONTEND_URL=http://localhost:5173
