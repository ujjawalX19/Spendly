# Application port
PORT=5000
NODE_ENV=development

# --- Supabase (Dashboard -> Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE ROLE key. Server only. NEVER put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Gemini AI (receipt scan, statement import, coach) ---
GEMINI_API_KEY=your-gemini-api-key-here
# Optional. Verify the model is still supported: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.5-flash

# --- Owner admin panel ---
# The ONE email address allowed into /api/admin. The account must also have a
# confirmed email and profiles.role = 'admin' (set once in the Supabase SQL
# editor — see ADMIN_PANEL.md). Unset = admin API closed to everyone.
ADMIN_EMAIL=

# --- Network ---
# Comma-separated browser origins allowed by CORS.
# Add the admin panel's origin here (e.g. its Vercel URL; http://localhost:5174 locally).
ALLOWED_ORIGINS=https://vittova.in,https://www.vittova.in,https://admin.vittova.in,https://spendly-iota.vercel.app,https://localhost,http://localhost,http://localhost:5173,http://localhost:5174
# Number of reverse-proxy hops in front of the app. Render = 1 (the default in
# production). Wrong values break per-client rate limiting. Never use "true".
# TRUST_PROXY=1

# --- Business timezone for all calendar maths (default Asia/Kolkata) ---
# APP_TIMEZONE=Asia/Kolkata

# --- Optional daily aggregate job (logs only; no push notifications exist) ---
# ENABLE_BURN_RATE_JOB=false

# --- Google Play Billing (see BILLING_ARCHITECTURE.md) ---
# Off unless "true". The service-account JSON is a secret: set it in the host's
# environment, never in a file in the repository.
# PLAY_BILLING_ENABLED=false
# PLAY_PACKAGE_NAME=com.vittova.app
# PLAY_PRO_PRODUCT_IDS=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Razorpay Pro passes (website and Indus Appstore build; lib/razorpayBilling.js).
# Off unless "true". Apply supabase/v1_15_razorpay_passes.sql first. The key
# secret and webhook secret are secrets: set them in the host's environment only.
# RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Real-time developer notifications (Pub/Sub push): expected audience and sender.
# PLAY_RTDN_AUDIENCE=
# PLAY_RTDN_SERVICE_ACCOUNT=

# --- Feature switches (lib/featureFlags.js; "true"/"false", defaults in brackets) ---
# SUBSCRIPTION_AUDIT_ENABLED [true]   SAVE_TO_EARN_ENABLED [true]   PRO_CHALLENGES_ENABLED [true]
# REWARDS_ENABLED [true]              REWARD_REDEMPTION_ENABLED [true]
# SPONSORED_CHALLENGES_ENABLED [false] CAMPAIGN_DASHBOARD_ENABLED [false]
# SPONSOR_DASHBOARD_ENABLED [false]   LIMITED_OFFER_ENABLED [false]
# STUDENT_PLAN_ENABLED is ignored: forced off until student verification exists.
# MINOR_ACCESS_ENABLED [false]        under-18 sign-ups (lib/ageAccess.js)

# --- Optional tuning ---
# GEMINI reply timeout in ms for the coach.
# AI_REPLY_TIMEOUT_MS=
# Which header carries the real client IP for rate limiting (middleware/rateLimits.js);
# "none" = use req.ip. Leave unset to use the built-in choice.
# CLIENT_IP_HEADER=

# Oldest Android versionCode still allowed to run (GET /api/app-config).
# Unset or 0 = nobody is blocked. Raise it only after the newer build is live
# on Google Play; older builds then show "Update Vittova".
MIN_SUPPORTED_ANDROID_VERSION_CODE=
